#!/bin/bash
#PBS -N test_hermitian_N1024
#PBS -A AbacusAurora
#PBS -l select=2:ncpus=64:mpiprocs=16:ompthreads=2
#PBS -l walltime=01:00:00
#PBS -l filesystems=home
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions/hermitian_3d_matrix_production/test_hermitian/test_hermitian.out

cd $PBS_O_WORKDIR

# Load modules
# Note: frameworks module provides MPI and OpenMP
# fftw module provides FFTW libraries
echo "Loading frameworks module..."
module load frameworks
echo "Loading FFTW module..."
module load fftw/3.3.10

# Check what's available after loading modules
echo "Checking MPI compiler..."
which mpicc
mpicc --version || echo "mpicc not found or error"

echo "Checking C++ compiler..."
which mpicxx
mpicxx --version || echo "mpicxx not found or error"

# Go to hermitian_3d_matrix_production directory
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

# Compile with double precision, VERIFY_HERMITIAN_SYMMETRY flag, and verification enabled
# Makefile auto selects correct FFTW libs based on CFLAGS
echo "Compiling hermitian_3d_matrix with double precision..."
echo "VERIFY_HERMITIAN_SYMMETRY: ENABLED (F=0, H=0 for Hermitian symmetry test + verification checks)"
echo "Verification: ENABLED (PRINT_DETAILED_SLICES, VERIFY_HERMITIAN_SYMMETRY)"
echo "Using SPLINE_RESOLUTION=512 for higher interpolation accuracy"
make clean
make CFLAGS="-DUSE_DOUBLE_PRECISION -DVERIFY_HERMITIAN_SYMMETRY=1 -DPRINT_DETAILED_SLICES=1 -DSKIP_VERIFICATION=0 -DSPLINE_RESOLUTION=512"

# Verify executable was created
if [ ! -f "./hermitian_3d_matrix" ]; then
    echo "ERROR: Compilation failed - executable not found!"
    exit 1
fi
echo "Compilation successful - executable found"

# Job parameters
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NRANKS_PER_NODE=16
NTHREADS_PER_RANK=2
NTOTRANKS=$((NNODES * NRANKS_PER_NODE))

# OpenMP settings
export OMP_NUM_THREADS=$NTHREADS_PER_RANK
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# Test parameters
N=1024
PARAM_FILE="examples/param_N1024.par"

# Check if parameter file exists
if [ ! -f "$PARAM_FILE" ]; then
    echo "ERROR: Parameter file not found: $PARAM_FILE"
    exit 1
fi

echo "=========================================="
echo "Test: Hermitian Symmetry Test (F=0, H=0)"
echo "Double Precision Build"
echo "VERIFY_HERMITIAN_SYMMETRY: ENABLED (sets F=0, H=0 + enables verification)"
echo "Verification: ENABLED"
echo "Spline Resolution: 512 (high accuracy)"
echo "N=$N, ranks=$NTOTRANKS, threads per rank=$NTHREADS_PER_RANK"
echo "Parameter file: $PARAM_FILE"
echo "Expected: With F=0 and H=0, conjugate slices are true conjugates"
echo "Expected: After 3D FFT, final matrix should be purely real (imaginary parts ≈ 0)"
echo "=========================================="
echo ""

# Create output directory if it doesn't exist
mkdir -p test_hermitian

# Run the program with parameter file
# Redirect all output to test_hermitian directory
mpiexec -n $NTOTRANKS \
        -ppn $NRANKS_PER_NODE \
        --depth=$NTHREADS_PER_RANK \
        --cpu-bind depth \
        ./hermitian_3d_matrix $N $PARAM_FILE 2>&1 | tee test_hermitian/test_hermitian.log

echo ""
echo "=========================================="
echo "Checking Hermitian Symmetry Verification Results..."
echo "=========================================="
grep -i "hermitian\|symmetry\|imaginary\|real" test_hermitian/test_hermitian.log | tail -20

echo ""
echo "Checking for verification errors..."
VERIFY_ERRORS=$(grep -i "ERROR.*hermitian\|ERROR.*symmetry" test_hermitian/test_hermitian.log | wc -l)
if [ "$VERIFY_ERRORS" -gt 0 ]; then
    echo "WARNING: Found $VERIFY_ERRORS Hermitian symmetry verification errors!"
    grep -i "ERROR.*hermitian\|ERROR.*symmetry" test_hermitian/test_hermitian.log | head -10
else
    echo "SUCCESS: No Hermitian symmetry verification errors found!"
fi

echo ""
echo "Checking final real-space verification..."
grep -i "max_imag\|rms_imag\|purely real\|NOT OK" test_hermitian/test_hermitian.log | tail -5

echo ""
echo "Job completed!"
echo "Output files saved to: test_hermitian/"
