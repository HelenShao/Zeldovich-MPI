option('double_precision', type: 'boolean', value: false, description: 'Use double precision FFTW (-DUSE_DOUBLE_PRECISION)')
option('production_mode', type: 'boolean', value: true, description: 'Enable PRODUCTION_MODE (quiet output, skip checks in config)')
option('particle_output_mode', type: 'integer', min: 0, max: 10, value: 3, description: 'PARTICLE_OUTPUT_MODE macro (see src/config.h); 3 = 1D z-group ic/ic_*, 4 = 2D z-slab layout')
option('skip_file_write', type: 'integer', min: 0, max: 1, value: 0, description: 'SKIP_FILE_WRITE (1 = skip Stage 3 .bin writes)')
option('parallelize_z_loop', type: 'integer', min: 0, max: 1, value: 1, description: 'PARALLELIZE_Z_LOOP')
option('debug_prints', type: 'boolean', value: true, description: 'DEBUG_PRINTS=1 when true (overridden to 0 when production_mode=true in config.h)')
option('debug_rng_consistency', type: 'boolean', value: true, description: 'DEBUG_RNG_CONSISTENCY')
option('debug_rng_skip', type: 'boolean', value: true, description: 'DEBUG_RNG_SKIP=1 when true')
option('use_fftw_wisdom', type: 'boolean', value: false, description: 'Define USE_FFTW_WISDOM')
option('fftw_root', type: 'string', value: '', description: 'FFTW install prefix if pkg-config is unavailable')
option('extra_cpp_args', type: 'array', value: [], description: 'Extra compiler defines/flags (e.g. -DMYFLAG)')
option('enable_asan', type: 'boolean', value: false, description: 'Enable AddressSanitizer')
option(
  'abacus_embed',
  type: 'boolean',
  value: false,
  description: 'Built as Abacus IC-embed subproject: omit STimer from libzeldovich_ic (Abacus provides STimer)',
)
