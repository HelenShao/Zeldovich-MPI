# Zeldovich-MPI parameter file -- crop test (b) at production size: N = 1800 from the FLAMINGO
# noise (N0 = 2048) with a flat P(k), so D = w / BoxSize^1.5 exactly and dens_* is the real-space
# cropped white noise, directly comparable with monofonIC's own 1800^3 white_noise field.
# Build: build_rt_load (LOAD_EXTERNAL_NOISE + DUMP_D_SLABS); noise dir via ZD_EXTERNAL_NOISE_DIR.

BoxSize = 673.2
NP = 5832000000                      # 1800^3
CPD = 225                            # 8 lattice planes per ic_ file
NumZRanks = 1
ICFormat = "RVZel"
InitialConditionsDirectory = "./ic"
InitialRedshift = 31.0

ZD_Version = 2
ZD_Seed = 1                          # unused with LOAD_EXTERNAL_NOISE
ZD_Pk_powerlaw_index = 0.0           # P(k) = 1 / BoxSize^3 with Pk_norm = 0 and no smoothing
ZD_Pk_scale = 1.0
ZD_Pk_norm = 0
ZD_Pk_sigma_ratio = 1.0
ZD_Pk_smooth = 0.0
ZD_qPk_fix_to_mean = 0
ZD_k_cutoff = 1.0
ZD_CornerModes = 1
ZD_f_NL = 0
ZD_qdensity = 1
ZD_f_cluster = 1.0
ZD_qPLT = 0
