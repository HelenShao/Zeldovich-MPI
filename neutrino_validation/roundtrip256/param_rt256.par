# Zeldovich-MPI round-trip test at N = 256 with the production IC settings of
# AbacusAurora_rockV2_c000_ph390_n800 (qPLT, Pk_norm = 8, 2D decomposition), only NP and CPD reduced.
# Used unchanged by all three builds (plain, seed + dumps, load dumped noise); run from the run directory.

BoxSize = 217
NP = 16777216                        # 256^3
CPD = 125
NumZRanks = 2
ICFormat = "RVZel_2D"
InitialConditionsDirectory = "./ic"
InitialRedshift = 99.0
Omega_M = 0.315192

