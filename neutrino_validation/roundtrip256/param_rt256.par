ZD_Pk_norm = 8.0
ZD_Pk_sigma_ratio = 0.021139501553941786
ZD_Pk_smooth = 0.0
ZD_f_cluster = 0.9954948095129318
ZD_k_cutoff = 1.0
ZD_qdensity = 1
ZD_qPLT = 1
ZD_qPLT_rescale = 1
