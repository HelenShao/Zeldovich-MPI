#!/bin/bash
#PBS -N v15_3_ps_dbl_N256
#PBS -A AbacusAurora
#PBS -l select=2:ncpus=64:mpiprocs=16:ompthreads=2
#PBS -l walltime=00:30:00
#PBS -l filesystems=home
#PBS -q debug
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions/hermitian_3d_matrix_production/v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.out

cd $PBS_O_WORKDIR

# Load modules
# Note: frameworks module provides MPI and OpenMP
# fftw module provides FFTW libraries
echo "Loading frameworks module..."
module load frameworks
echo "Loading FFTW module..."
module load fftw/3.3.10

# Check what's available after loading modules
echo "Checking MPI compiler..."
which mpicc
mpicc --version || echo "mpicc not found or error"

echo "Checking C++ compiler..."
which mpicxx
mpicxx --version || echo "mpicxx not found or error"

# Go to hermitian_3d_matrix_production directory
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

# Compile with double precision, RNG consistency debugging, RNG skip debugging, and RNG verification
# Makefile auto selects correct FFTW libs based on CFLAGS
echo "Compiling hermitian_3d_matrix with double precision, RNG consistency debugging, RNG skip debugging, and RNG verification..."
echo "FIX: Skip logic now matches zeldovich.cpp (skip at Nyquist boundary instead of end of row)"
make clean
make CFLAGS="-DUSE_DOUBLE_PRECISION -DDEBUG_RNG_CONSISTENCY=1 -DDEBUG_RNG_SKIP=1 -DVERIFY_RNG_CALLS=1"

# Job parameters
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NRANKS_PER_NODE=16
NTHREADS_PER_RANK=2
NTOTRANKS=$((NNODES * NRANKS_PER_NODE))

# OpenMP settings
export OMP_NUM_THREADS=$NTHREADS_PER_RANK
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# Test parameters
N=256
PARAM_FILE="examples/param_N256.par"

# Check if parameter file exists
if [ ! -f "$PARAM_FILE" ]; then
    echo "ERROR: Parameter file not found: $PARAM_FILE"
    exit 1
fi

echo "=========================================="
echo "Test: v15.3 Power Spectrum Mode"
echo "Double Precision Build with RNG Consistency Debugging"
echo "RNG Skip Debugging: ENABLED (DEBUG_RNG_SKIP=1)"
echo "RNG Verification: ENABLED (VERIFY_RNG_CALLS=1)"
echo "FIX: Skip at Nyquist boundary (x/z == Nhalf+1) instead of end of row"
echo "N=$N, ranks=$NTOTRANKS"
echo "Parameter file: $PARAM_FILE"
echo "Should use zeldovich-PLT PowerSpectrum and RNG"
echo "RNG debug: Tests coordinates <= 127 (overlapping region boundary)"
echo "RNG skip debug: Traces skip accumulation and application"
echo "RNG verify: Checks total RNG calls = 2 * MAX_PPD * MAX_PPD per Y-slice"
echo "=========================================="
echo ""

# Run the program with parameter file
mpiexec -n $NTOTRANKS \
        -ppn $NRANKS_PER_NODE \
        --depth=$NTHREADS_PER_RANK \
        --cpu-bind depth \
        ./hermitian_3d_matrix $N $PARAM_FILE 2>&1 | tee v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log

echo ""
echo "=========================================="
echo "Checking RNG Verification Results..."
echo "=========================================="
grep -i "RNG-VERIFY" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | head -20

echo ""
echo "Checking for RNG verification errors..."
RNG_ERRORS=$(grep -i "RNG-VERIFY ERROR" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | wc -l)
if [ "$RNG_ERRORS" -gt 0 ]; then
    echo "WARNING: Found $RNG_ERRORS RNG verification errors!"
    grep -i "RNG-VERIFY ERROR" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | head -10
else
    echo "SUCCESS: No RNG verification errors found!"
fi

echo ""
echo "Checking RNG verification OK messages..."
RNG_OK=$(grep -i "RNG-VERIFY OK" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | wc -l)
echo "Found $RNG_OK RNG verification OK messages (should see messages for first few Y-slices)"

# echo ""
# echo "Checking if output is purely real..."
# grep -i "imaginary\|complex\|real" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | tail -5

# echo ""
# echo "Checking power spectrum initialization..."
# grep -i "power.*spectrum\|PowerSpectrum\|powerlaw\|fundamental\|boxsize" v15_3_tests/test_v15_3_powerspectrum_N256_double_aurora.log | head -10

echo ""
echo "Job completed!"

