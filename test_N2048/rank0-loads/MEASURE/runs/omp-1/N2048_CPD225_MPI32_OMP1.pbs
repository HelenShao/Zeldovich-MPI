#!/bin/bash
#PBS -N s2048_1dr0_o1
#PBS -A Abacus
#PBS -l select=8:ncpus=2:mpiprocs=2:ompthreads=1
#PBS -l walltime=00:15:00
#PBS -q debug-scaling
#PBS -l filesystems=home
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/N2048_CPD225_MPI32_OMP1.out

cd /home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1
if [ -d "bin_files" ]; then rm -rf bin_files/rank_*; fi
if [ -d "rng_logs" ]; then rm -f rng_logs/*.log rng_logs/*.txt 2>/dev/null || true; fi
rm -f *.log 2>/dev/null || true

cd "$PBS_O_WORKDIR"
module load frameworks
module load fftw/3.3.10
module load hwloc
cd /home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production

if [ -n "$PBS_NODEFILE" ] && [ -f "$PBS_NODEFILE" ]; then
    NTOTRANKS=$(wc -l < "$PBS_NODEFILE")
    echo "DEBUG: PBS_NODEFILE=$PBS_NODEFILE, NTOTRANKS=$NTOTRANKS"
else
    NTOTRANKS=16
fi
export NTOTRANKS
NTHREADS_PER_RANK=1

make clean
make CFLAGS="-DPRODUCTION_MODE -DPARTICLE_OUTPUT_MODE=4 -DSKIP_FILE_WRITE=0 -DPARALLELIZE_Z_LOOP=1 -DDEBUG_PRINTS=0 -DDEBUG_RNG_SKIP=0 -DUSE_FFTW_WISDOM -g" -B
[ ! -f "./hermitian_3d_matrix" ] && { echo "Compilation failed!"; exit 1; }
make wisdom-rank0
[ ! -f "./wisdom_rank0" ] && { echo "wisdom_rank0 build failed!"; exit 1; }

N=2048
cp "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/metadata/param_N2048_CPD_225.par" "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/param_runtime_OMP1.par"
RAMDISK_IC_DIR="/dev/shm/hshao/zeldovich-MPI/${PBS_JOBID:-nojob}/rank0-loads/omp-1"
mkdir -p "$RAMDISK_IC_DIR"
if command -v pbsdsh >/dev/null 2>&1; then
  pbsdsh -u mkdir -p "$RAMDISK_IC_DIR"
else
  echo "WARNING: pbsdsh not found; /dev/shm directory may only exist on launch node: $RAMDISK_IC_DIR"
fi

sed -i "s|^InitialConditionsDirectory[[:space:]]*=.*$|InitialConditionsDirectory = \"/lus/flare/projects/AbacusAurora/hshao/zeldovich-MPI/PPD_2048_cosm_000/z_24/rank0-loads/omp-1/\"|" "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/param_runtime_OMP1.par"
mkdir -p 

mkdir -p "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/bin_files" "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/rng_logs"
rm -rf "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/bin_files"/rank_* 2>/dev/null || true
rm -f "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/bin_files/fftw_wisdom_float.wisdom" 2>/dev/null || true

RNG_LOG_DIR="/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/rng_logs"
mkdir -p "$RNG_LOG_DIR"

cd "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/bin_files"
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export OMP_DISPLAY_AFFINITY=false
export OMP_NUM_THREADS=$NTHREADS_PER_RANK
/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/wisdom_rank0 2048 4 >> "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/N2048_CPD225_MPI32_OMP1_wisdom_preflight.log" 2>&1
unset OMP_NUM_THREADS

ulimit -c unlimited

mpiexec -ppn 2 --cpu-bind depth --depth $NTHREADS_PER_RANK --mem-bind list:0:1 -np $NTOTRANKS \
        --env OMP_NUM_THREADS=$NTHREADS_PER_RANK --env OMP_PLACES=cores --env OMP_PROC_BIND=close --env OMP_DISPLAY_AFFINITY=false \
        /home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/hermitian_3d_matrix $N "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/param_runtime_OMP1.par" \
        > "/home/helenshao/InitialConditions-wisdom/hermitian_3d_matrix_production/test_N2048/rank0-loads/MEASURE/runs/omp-1/N2048_CPD225_MPI32_OMP1_bin_generation.log" 2> "$RNG_LOG_DIR/zd_mpi_rng_debug.log"
