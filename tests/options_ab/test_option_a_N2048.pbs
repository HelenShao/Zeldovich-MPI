#!/bin/bash
#PBS -N test_option_a_N2048
#PBS -A AbacusAurora
#PBS -l select=6:ncpus=64:mpiprocs=14:ompthreads=4
#PBS -l walltime=02:00:00
#PBS -l filesystems=home
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions/hermitian_3d_matrix_production/tests/options_ab/test_option_a_N2048.out

cd $PBS_O_WORKDIR

# Load modules
# Note: frameworks module provides MPI and OpenMP
# fftw module provides FFTW libraries
echo "Loading frameworks module..."
module load frameworks
echo "Loading FFTW module..."
module load fftw/3.3.10

# Go to hermitian_3d_matrix_production directory
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

# Compile Option A (transpose + WriteParticlesSlab_range)
echo "Compiling with Option A (USE_PARTICLE_OUTPUT_OPTION_B=0)..."
make clean
make CFLAGS="-DUSE_PARTICLE_OUTPUT_OPTION_B=0 -DVERIFY_HERMITIAN_SYMMETRY=0 -DSKIP_FILE_WRITE=0" -B

# Verify executable was created
if [ ! -f "./hermitian_3d_matrix" ]; then
    echo "ERROR: Compilation failed - executable not found!"
    exit 1
fi
echo "Compilation successful - executable found"

# Job parameters
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NRANKS_PER_NODE=14
NTHREADS_PER_RANK=4
NTOTRANKS=$((NNODES * NRANKS_PER_NODE))

# OpenMP settings
export OMP_NUM_THREADS=$NTHREADS_PER_RANK
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# Test parameters
N=2048
PARAM_FILE="examples/param_N2048.par"

# Check if parameter file exists
if [ ! -f "$PARAM_FILE" ]; then
    echo "ERROR: Parameter file not found: $PARAM_FILE"
    exit 1
fi

echo "=========================================="
echo "Test: Option A (Transpose + WriteParticlesSlab_range)"
echo "N=$N, ranks=$NTOTRANKS, threads per rank=$NTHREADS_PER_RANK"
echo "Parameter file: $PARAM_FILE"
echo "=========================================="
echo ""

# Create output directory if it doesn't exist
mkdir -p tests/options_ab

# Run the program with parameter file
# Redirect all output to tests/options_ab directory
mpiexec -n $NTOTRANKS \
        -ppn $NRANKS_PER_NODE \
        --depth=$NTHREADS_PER_RANK \
        --cpu-bind depth \
        ./hermitian_3d_matrix $N $PARAM_FILE 2>&1 | tee tests/options_ab/test_option_a_N2048.log

echo ""
echo "Job completed!"
echo "Output files saved to: tests/options_ab/"
