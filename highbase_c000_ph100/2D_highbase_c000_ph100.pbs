#!/bin/bash
#PBS -N 2D_highbase_c000_ph100
#PBS -A AbacusAurora
# 32 MPI ranks total = 16 nodes × 2 ranks/node (match NRANKS_PER_NODE below)
#PBS -l select=16:ncpus=16:mpiprocs=2:ompthreads=8
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -q debug-scaling
#PBS -l filesystems=home:flare
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions/hermitian_3d_matrix_production/highbase_c000_ph100/2D/2D_highbase_c000_ph100.out

# Aurora MPI+OpenMP:
# mpiexec -n NTOTRANKS --ppn NRANKS_PER_NODE --depth=NDEPTH --cpu-bind depth \
#          --env OMP_NUM_THREADS=NTHREADS --env OMP_PLACES=cores
# “It is highly likely you will also want to add -l place=scatter so that each of your chunks (<# of nodes>) gets its own vnode.”

BASE_DIR="/home/helenshao/InitialConditions/hermitian_3d_matrix_production/highbase_c000_ph100/2D"
cd "${PBS_O_WORKDIR:-$BASE_DIR}"

# Load modules
echo "Loading frameworks module..."
module load frameworks
echo "Loading FFTW module..."
module load fftw/3.3.10

# Go to hermitian_3d_matrix_production directory
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

# ====================================================================================
# STEP 1: Compile (PARTICLE_OUTPUT_MODE=4, PLT)
# ====================================================================================
make clean
make CFLAGS="-DPRODUCTION_MODE -DPARTICLE_OUTPUT_MODE=4 -DSKIP_FILE_WRITE=0 -DPARALLELIZE_Z_LOOP=1 -DDEBUG_PRINTS=1 -DDEBUG_RNG_CONSISTENCY=1 -DDEBUG_RNG_SKIP=1 -g" -B

# Verify executables were created
if [ ! -f "./hermitian_3d_matrix" ]; then
    echo "ERROR: Compilation failed - hermitian_3d_matrix executable not found!"
    exit 1
fi
echo "Compilation successful"

# Job parameters (must match #PBS -l select: NNODES * NRANKS_PER_NODE == NTOTRANKS == 32 here)
NRANKS_PER_NODE=2
NTHREADS_PER_RANK=8
NDEPTH=$NTHREADS_PER_RANK
# counting nodes below is wrong, PBS_NODEFILE has one line per mpi rank, not per node.
if [ -n "$PBS_NODEFILE" ] && [ -f "$PBS_NODEFILE" ]; then
  NTOTRANKS=$(wc -l < "$PBS_NODEFILE")
else
  NTOTRANKS=32
fi
# NTOTRANKS=$((NNODES * NRANKS_PER_NODE))
MPI_PPN=$NRANKS_PER_NODE

export OMP_NUM_THREADS=$NTHREADS_PER_RANK OMP_PLACES=cores OMP_PROC_BIND=close

# Test parameters
N=3456
PARAM_FILE="$BASE_DIR/2D_highbase_c000_ph100.par"
# Run root from param (InitialConditionsDirectory; code appends ic/ and dens/) — path must be double-quoted in .par
PARTICLE_OUTPUT_DIR=$(grep '^[[:space:]]*InitialConditionsDirectory' "$PARAM_FILE" | head -1 | cut -d'"' -f2)
if [ -z "$PARTICLE_OUTPUT_DIR" ]; then
  echo "ERROR: InitialConditionsDirectory missing or not double-quoted in $PARAM_FILE"
  exit 1
fi
BIN_OUTPUT_DIR="$BASE_DIR/bin_files"
RNG_LOG_DIR="$BASE_DIR/rng_logs"

# Create output directories (IC files on flare; local dirs for logs / any rank_* scratch)
mkdir -p "$PARTICLE_OUTPUT_DIR" "$BASE_DIR" "$BIN_OUTPUT_DIR" "$RNG_LOG_DIR"
rm -rf "$BIN_OUTPUT_DIR"/rank_* 2>/dev/null || true

# ====================================================================================
# STEP 2: Run main.cpp
# ====================================================================================
echo ""
echo "=========================================="
echo "STEP 2: Run (N=$N, ranks=$NTOTRANKS, threads=$NTHREADS_PER_RANK)"
echo "         param: 2D_highbase_c000_ph100.par (2D decomposition, Mode 4 output)"
echo "         nodes=$NTOTRANKS/$RANKS_PER_NODE ppn=$NRANKS_PER_NODE depth=$NDEPTH (Aurora MPI+OpenMP pattern)"
echo "=========================================="

EXECUTABLE_PATH="/home/helenshao/InitialConditions/hermitian_3d_matrix_production/hermitian_3d_matrix"

if [ ! -f "$EXECUTABLE_PATH" ]; then
    echo "ERROR: Executable not found: $EXECUTABLE_PATH"
    exit 1
fi

echo "Running: $EXECUTABLE_PATH $N $PARAM_FILE"
echo "Program stdout: $BASE_DIR/2D_highbase_c000_ph100_bin_generation.log"
echo "Program stderr (RNG debug): $RNG_LOG_DIR/hermitian_rng_debug.log"
echo ""

ulimit -c unlimited

cd "$BIN_OUTPUT_DIR"
mpiexec -n $NTOTRANKS --ppn $MPI_PPN --depth=$NDEPTH --cpu-bind depth \
        --env OMP_NUM_THREADS=$NTHREADS_PER_RANK --env OMP_PLACES=cores --env OMP_PROC_BIND=close \
        "$EXECUTABLE_PATH" $N "$PARAM_FILE" \
        > "$BASE_DIR/2D_highbase_c000_ph100_bin_generation.log" 2> "$RNG_LOG_DIR/hermitian_rng_debug.log"

# Return to project root
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

IC_COUNT=$(find "$PARTICLE_OUTPUT_DIR" -type f \( -name "ic_*" -o -path "*/ic/*" \) 2>/dev/null | wc -l)
echo "Generated $IC_COUNT particle IC files / segments under $PARTICLE_OUTPUT_DIR"

if [ "$IC_COUNT" -eq 0 ]; then
    echo "WARNING: No particle IC files found under $PARTICLE_OUTPUT_DIR"
fi

echo ""
echo "=========================================="
echo "Mode 4 run complete ($NNODES nodes, $NRANKS_PER_NODE ranks/node, $NTHREADS_PER_RANK threads/rank, N=$N, PLT enabled)"
echo "=========================================="
echo "  Particle IC files: $IC_COUNT"
echo "  IC output: $PARTICLE_OUTPUT_DIR"
echo "  Logs: $BASE_DIR/"
