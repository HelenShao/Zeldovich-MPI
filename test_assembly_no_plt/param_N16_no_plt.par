# zeldovich-PLT Parameter File
# For N=16 grid with power law power spectrum
# PLT DISABLED for testing
# Usage: ./hermitian_3d_matrix 16 test_assembly_no_plt/param_N16_no_plt.par

BoxSize = 100.0
CPD = 4                          # Cells per dimension (= N)
ICFormat = "RVZel"
InitialConditionsDirectory = "./output"
InitialRedshift = 99.0
NP = 4096                         # N^3 = 16^3
ZD_NumBlock = 2
ZD_Seed = 4                        # Random seed
ZD_Pk_scale = 1.0
ZD_Pk_norm = 8.0                   # Normalization scale (e.g., sigma_8)
ZD_Pk_sigma = 1.0                  # Amplitude at normalization scale (required when Pk_norm > 0)
ZD_Pk_smooth = 0.0
ZD_Pk_powerlaw_index = -2.0        # Power law: P(k) ~ k^-2
ZD_Version = 2                     # Use version 2 (recommended)
ZD_qPk_fix_to_mean = 0             # Random amplitude (not fixed)
ZD_f_NL = 0                        # No f_NL
qdensity = 1                       # Output density field

# PLT (Particle Linear Theory) settings - DISABLED
ZD_qPLT = 0                        # Disable PLT mode for testing
ZD_qPLTrescale = 0                 # Disable PLT rescaling
ZD_PLT_target_z = 0.0              # Not used when PLT is disabled

# ZD_PLT_filename not needed when PLT is disabled

