# Cosm500 1-rank Zeldovich-MPI control (500^3, CPD=243)
#
# MPI: mpiexec -n 1 with NumZRanks=1 => grid 1 x 1 (no Alltoallv exchange).
# N is taken from NP below; do not pass N on the command line.
#
# Paths below are placeholders; run.sh writes .runtime/param.par2 with absolute
# paths from IC_OUTPUT_DIR, PK_FILE, and PLT_FILE (see env.sh / README).

BoxSize = 325.
NP = 2097152 #N=128, 128^3
CPD = 243
InitialConditionsDirectory = "./output"
InitialRedshift = 49.
ICFormat = "RVZel"
ZD_NumBlock = 4
ZD_Pk_filename = "./data/class_pk_z0.dat"
ZD_Pk_primordial_filename = "./data/class_pk_primordial_dimensional.dat"
ZD_Seed = 12345.
ZD_qPLT = 1
ZD_PLT_filename = "./data/eigmodes128"
ZD_qPLT_rescale = 1
ZD_PLT_target_z = 5
ZD_k_cutoff = 1.
ZD_Pk_scale = 1.0
ZD_Pk_norm = 8.0
ZD_Pk_smooth = 0.0
ZD_Version = 2
ZD_f_cluster = 1.0
ZD_Pk_sigma = 0.02086274818611812
ZD_qPk_fix_to_mean = 0
ZD_f_NL = 0
ZD_qdensity = 1

NumZRanks = 1
ZD_NumZRanks = 1

# Charlie: added to toggle which f_NL to compute
ZD_f_NL_local = 1
ZD_f_NL_equil = 0
ZD_f_NL_orthoCMB = 0
