#!/bin/bash
#PBS -N toy_1rank_first_touch
#PBS -A AbacusAurora
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=16
#PBS -l walltime=00:30:00
#PBS -q capacity
#PBS -l filesystems=home
#PBS -M helenshao0904@gmail.com
#PBS -m abe
#PBS -j oe
#PBS -o /home/helenshao/InitialConditions/hermitian_3d_matrix_production/toy/toy_omp_1rank_first_touch.out

# Toy z-loop OMP sweep with 1 MPI rank, TOY_FIRST_TOUCH=1 (parallel first-touch for NUMA).
# Compare with toy_omp_1rank_sweep.out (no first-touch) to see if Z-loop times improve.

set -e
cd /home/helenshao/InitialConditions/hermitian_3d_matrix_production

echo "Loading modules..."
module load frameworks
module load fftw/3.3.10

echo "Building toy_zloop_omp_scaling..."
make toy-zloop
if [ ! -f "./toy_zloop_omp_scaling" ]; then
    echo "ERROR: toy_zloop_omp_scaling not found"
    exit 1
fi

export TOY_FIRST_TOUCH=1

NNODES=1
PARAM_FILE="/home/helenshao/InitialConditions/hermitian_3d_matrix_production/test_N1024/CPD-225/MPI-9/mode3/1D/param_N1024_CPD_225.par"
N=1024
NARRAY=2
REPEATS=10
THREADS="1 2 4 8 16"

export OMP_PLACES=cores
export OMP_PROC_BIND=close

echo "=========================================="
echo "Toy OMP sweep with $NNODES MPI rank(s), TOY_FIRST_TOUCH=1"
echo "  N=$N narray=$NARRAY num_y_repeats=$REPEATS"
echo "  Thread list: $THREADS"
echo "=========================================="

for t in $THREADS; do
  echo ""
  echo "========== OMP_NUM_THREADS=$t (1 rank, first-touch) =========="
  export OMP_NUM_THREADS=$t
  mpiexec -n $NNODES ./toy_zloop_omp_scaling "$N" "$NARRAY" "$PARAM_FILE" "$REPEATS"
done

echo ""
echo "--- sweep done ---"
