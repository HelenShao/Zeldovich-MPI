# zeldovich-PLT Parameter File
# For N=1024 grid with power law power spectrum
# CPD-225 test (PLT ENABLED, rescaling ENABLED, 32 nodes, 1 rank per node, CPD=225)
# Testing k_cutoff implementation (k_cutoff=1.0, CornerModes=0)
# Usage: ./hermitian_3d_matrix 1024 test_N1024/CPD-225/param_N1024_CPD_225.par
# NOTE: ZD_qdensity=1 (just_density=1) - outputs density + displacement (narray=2)

BoxSize = 100.0
CPD = 225
ICFormat = "RVZel"
InitialConditionsDirectory = "./output"
InitialRedshift = 99.0
NP = 1073741824                      # N^3 = 1024^3 = 1073741824
ZD_NumBlock = 2
ZD_Seed = 4                          # Random seed (must match zeldovich-PLT)
ZD_Pk_scale = 1.0
ZD_Pk_norm = 8.0                     # Normalization scale (e.g., sigma_8)
ZD_Pk_sigma = 1.0                    # Amplitude at normalization scale (required when Pk_norm > 0)
ZD_Pk_smooth = 0.0
ZD_Pk_powerlaw_index = -2.0          # Power law: P(k) ~ k^-2
ZD_Version = 2                       # Use version 2 (recommended)
ZD_qPk_fix_to_mean = 0               # Random amplitude (not fixed)
ZD_f_NL = 0                          # No f_NL
ZD_qdensity = 1                      # Output density + displacement (mode 1, narray=2)

# k_cutoff and CornerModes settings (testing k_cutoff implementation)
ZD_k_cutoff = 1.0                    # k_max = k_Nyquist / k_cutoff = 512 / 1.0 = 512 (full range for N=1024)
ZD_CornerModes = 0                    # Zero modes with k² >= k2_cutoff (default)

# PLT (Particle Linear Theory) settings - ENABLED for PLT test (rescaling ENABLED)
ZD_qPLT = 1                          # Enable PLT mode
ZD_qPLTrescale = 1                   # Enable PLT rescaling
ZD_PLT_target_z = 0.0                # Target redshift for PLT
ZD_PLT_filename = "/home/helenshao/InitialConditions/zeldovich-PLT/eigmodes128"    # PLT eigenmode file (required when PLT is enabled)

# MPI grid decomposition (grid_x * grid_z = num_ranks)
ZD_grid_x = 3
ZD_grid_z = 3
